{
  "name": "the-last-onion-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "postinstall": "prisma generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@prisma/client": "^6.9.0",
    "bcrypt": "^6.0.0",
    "fastify": "^5.3.3",
    "socket.io": "^4.8.1",
    "zod": "^3.25.36"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^24.12.2",
    "prisma": "^6.9.0",
    "tsx": "^4.19.4",
    "typescript": "~6.0.0",
    "vitest": "^4.1.4"
  }
}
